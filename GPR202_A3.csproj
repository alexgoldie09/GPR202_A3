<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GPR202_A3</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.8.2" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StirlingLabs.assimp.native.win-x64" Version="5.2.5.4" />
    <PackageReference Include="StirlingLabs.Assimp.Net" Version="23.4.1" />
  </ItemGroup>

  <!--
    Copy every asset next to the compiled executable (bin/<Config>/net8.0/...) on each build.
    AssetPaths loads from there, so the game finds its files whether it is launched from
    the IDE, with `dotnet run`, or by double-clicking the .exe in bin/ (as submitted).
    "Update" (not "Include") is used because the SDK already includes these files as None items.
  -->
  <ItemGroup>
    <None Update="Shaders\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Resource\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
